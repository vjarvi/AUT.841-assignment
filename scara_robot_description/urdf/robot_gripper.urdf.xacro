<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="scara_gripper" params="parent_link xyz:='0 0 0' rpy:='0 0 0'
                                             finger_length:='0.15' finger_min:='0.02' finger_stroke:='0.1'">

        <joint name="fixed_joint_2" type="fixed">
            <parent link="${parent_link}"/>
            <child link="link_6"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
        <link name="link_6">
            <visual>
                <origin xyz="0 0 -0.025" rpy="0 0 0"/>
                <geometry>
                    <box size="0.3 0.1 0.05"/>
                </geometry>
                <material name="Grey">
                    <color rgba="0.5 0.5 0.5 1.0"/>
                </material>
            </visual>
        </link>
        
        <joint name="joint_5" type="prismatic">
            <parent link="link_6"/>
            <child link="link_7"/>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="${finger_min}" upper="${finger_min + finger_stroke}" effort="10" velocity="0.1"/>
        </joint>
        <link name="link_7">
            <visual>
                <origin xyz="0 0 ${-finger_length/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.05 ${finger_length}"/>
                </geometry>
                <material name="Red">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
        </link>
        <joint name="joint_6" type="prismatic">
            <parent link="link_6"/>
            <child link="link_8"/>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="${-(finger_min + finger_stroke)}" upper="${-finger_min}" effort="10" velocity="0.1"/>
            <mimic joint="joint_5" multiplier="-1" offset="0"/>
        </joint>
        <link name="link_8">
            <visual>
                <origin xyz="0 0 ${-finger_length/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.05 ${finger_length}"/>
                </geometry>
                <material name="Red">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
        </link>
        <!-- End-effector frame -->
        <joint name="fixed_joint_3" type="fixed">
            <parent link="link_6"/>
            <child link="tcp"/>
            <origin xyz="0 0 ${-(0.05 + finger_length)}" rpy="0 0 0"/>
        </joint>
        <link name="tcp"/>

    </xacro:macro>

</robot>
